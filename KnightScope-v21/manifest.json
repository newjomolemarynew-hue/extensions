{
  "manifest_version": 3,
  "name": "KnightScope",
  "short_name": "KnightScope",
  "version": "21.0.0",
  "description": "KnightScope V21 — improved dashboard accessibility and review workflow reliability.",
  "permissions": [
    "offscreen",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://api.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KnightScope",
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "icons/knight.png",
      "32": "icons/knight.png",
      "48": "icons/knight.png",
      "128": "icons/knight.png"
    }
  },
  "icons": {
    "16": "icons/knight.png",
    "32": "icons/knight.png",
    "48": "icons/knight.png",
    "128": "icons/knight.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "chess.js",
        "brain.js",
        "liquid.js",
        "customization/pieces.js",
        "customization/fx.js",
        "customization/board-fx.js",
        "customization/customization.js",
        "features/fx-live.js",
        "features/board-state.js",
        "features/auto-play.js",
        "features/game-mode.js",
        "features/player-ratings.js",
        "features/opponent-auto-config.js",
        "features/engine-client.js",
        "features/arrow-renderer.js",
        "features/panel-template.js",
        "features/review-prompt.js",
        "features/whats-new.js",
        "features/live-panel.js",
        "bm-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "features/bot-ratings.json",
        "features/panel.css"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: https://assets-themes.chess.com https://images.chesscomfiles.com; connect-src 'self' https://api.chess.com"
  },
  "homepage_url": "https://github.com/newjomolemarynew-hue/extensions"
}
